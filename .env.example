# Copy to .env and fill in what you need. Everything is optional.

# Database: SQLite is used if this is empty.
# DATABASE_URL=mysql://root:yourpassword@localhost:3306/trade_ai

# LLM (optional). With no key the app uses its built-in offline writer.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5-5
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

SECRET_KEY=change-me
